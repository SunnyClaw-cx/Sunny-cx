# 统一换行符，避免跨平台 checkout 破坏脚本
* text=auto

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# 二进制，禁止换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.wav binary
*.pth binary
